# OpenAI Chat Completions 兼容服务（复制为 .env 后填写）
# 本地直接运行 Go 后端时，如需要可同时填写 STUDYROOM_DB_URL / Redis 配置。
STUDYROOM_AI_BASE_URL=https://api.openai.com/v1
STUDYROOM_AI_API_KEY=
STUDYROOM_AI_MODEL=gpt-4o-mini

# 可选：请求控制
STUDYROOM_AI_CONNECT_TIMEOUT_SECONDS=10
STUDYROOM_AI_RESPONSE_TIMEOUT_SECONDS=60
STUDYROOM_AI_CONTEXT_MESSAGES=20
